{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "factory://schemas/runner-receipt/1",
  "title": "Factory hardened runner execution receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_id",
    "run_id",
    "generation",
    "role",
    "runner_manifest_digest",
    "runner_id",
    "adapter",
    "executable_digest",
    "runner_version",
    "model",
    "model_version",
    "configuration_digest",
    "billing_key_name",
    "secret_names",
    "qualification_digest",
    "canary_session_id",
    "resumed_session_id",
    "continuity_nonce_digest",
    "canary_attempts",
    "task_attempt",
    "input_tokens",
    "output_tokens",
    "cost_microusd",
    "cost_known",
    "meter_semantics",
    "process_peak",
    "termination_reason",
    "handoff_digest",
    "started_at",
    "finished_at"
  ],
  "properties": {
    "schema_version": {"const": "factory-runner-receipt/1"},
    "receipt_id": {"$ref": "#/$defs/id"},
    "run_id": {"$ref": "#/$defs/id"},
    "generation": {"type": "integer", "minimum": 1},
    "role": {"enum": ["coder", "tester", "validator"]},
    "runner_manifest_digest": {"$ref": "#/$defs/digest"},
    "runner_id": {"$ref": "#/$defs/id"},
    "adapter": {"enum": ["codex", "ollama-codex"]},
    "executable_digest": {"$ref": "#/$defs/digest"},
    "runner_version": {"type": "string", "minLength": 1},
    "model": {"type": "string", "minLength": 1},
    "model_version": {"type": "string", "minLength": 1},
    "configuration_digest": {"$ref": "#/$defs/digest"},
    "billing_key_name": {"$ref": "#/$defs/env_name"},
    "secret_names": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/env_name"}},
    "qualification_digest": {"$ref": "#/$defs/digest"},
    "canary_session_id": {"type": "string", "minLength": 1},
    "resumed_session_id": {"type": "string", "minLength": 1},
    "continuity_nonce_digest": {"$ref": "#/$defs/digest"},
    "canary_attempts": {"const": 2},
    "task_attempt": {"const": 3},
    "input_tokens": {"type": "integer", "minimum": 0},
    "output_tokens": {"type": "integer", "minimum": 0},
    "cost_microusd": {"type": ["integer", "null"], "minimum": 0},
    "cost_known": {"type": "boolean"},
    "meter_semantics": {"enum": ["observed-post-call", "provider-hard-limit"]},
    "process_peak": {"type": "integer", "minimum": 1},
    "termination_reason": {"const": "completed"},
    "handoff_digest": {"$ref": "#/$defs/digest"},
    "started_at": {"type": "integer", "minimum": 1},
    "finished_at": {"type": "integer", "minimum": 1}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "env_name": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,127}$"}
  }
}

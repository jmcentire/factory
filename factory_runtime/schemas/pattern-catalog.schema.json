{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "factory://schemas/pattern-catalog/1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "catalog_id", "version", "patterns"],
  "properties": {
    "schema_version": {"const": "factory-pattern-catalog/1"},
    "catalog_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "patterns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["pattern_id", "version", "artifact_digest", "qualification_evidence_digest", "mechanism"],
        "properties": {
          "pattern_id": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "artifact_digest": {"$ref": "#/$defs/digest"},
          "qualification_evidence_digest": {"$ref": "#/$defs/digest"},
          "mechanism": {"type": "object", "minProperties": 1}
        }
      }
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}

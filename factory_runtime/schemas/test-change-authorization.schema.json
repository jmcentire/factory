{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "factory://schemas/test-change-authorization/1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "authorization_id", "version", "run_id", "human_authorizer", "ruling", "expected_change_statement", "phase_artifact_digests", "old_behavior", "new_behavior", "selection"],
  "properties": {
    "schema_version": {"const": "factory-test-change-authorization/1"},
    "authorization_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "human_authorizer": {"type": "string", "minLength": 1},
    "ruling": {"const": "change-expected-behavior"},
    "expected_change_statement": {"type": "string", "minLength": 1},
    "phase_artifact_digests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product-specification", "architecture", "operational-maturity"],
      "properties": {
        "product-specification": {"$ref": "#/$defs/digest"},
        "architecture": {"$ref": "#/$defs/digest"},
        "operational-maturity": {"$ref": "#/$defs/digest"}
      }
    },
    "old_behavior": {"$ref": "#/$defs/backreference"},
    "new_behavior": {"$ref": "#/$defs/backreference"},
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family_id", "members"],
      "properties": {
        "family_id": {"type": "string"},
        "members": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["test_id", "assertion_digest"],
            "properties": {
              "test_id": {"type": "string", "minLength": 1},
              "assertion_digest": {"$ref": "#/$defs/digest"}
            }
          }
        }
      }
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "backreference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "artifact_digest", "item_id", "intent_digest"],
      "properties": {
        "artifact_id": {"type": "string", "minLength": 1},
        "artifact_digest": {"$ref": "#/$defs/digest"},
        "item_id": {"type": "string", "minLength": 1},
        "intent_digest": {"$ref": "#/$defs/digest"}
      }
    }
  }
}

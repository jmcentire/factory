{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "factory://schemas/acceptance-obligation-catalog/1",
  "title": "Factory human and Validator ratified acceptance-obligation catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "catalog_id",
    "version",
    "run_id",
    "generation",
    "target_state_digest",
    "phase_artifact_digests",
    "human_ratifier",
    "validator_ratifier",
    "max_review_rounds",
    "triggers"
  ],
  "properties": {
    "schema_version": {"const": "factory-acceptance-obligation-catalog/1"},
    "catalog_id": {"$ref": "#/$defs/id"},
    "version": {"type": "string", "minLength": 1, "maxLength": 128},
    "run_id": {"$ref": "#/$defs/id"},
    "generation": {"type": "integer", "minimum": 1},
    "target_state_digest": {"$ref": "#/$defs/digest"},
    "phase_artifact_digests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product-specification", "architecture", "operational-maturity"],
      "properties": {
        "product-specification": {"$ref": "#/$defs/digest"},
        "architecture": {"$ref": "#/$defs/digest"},
        "operational-maturity": {"$ref": "#/$defs/digest"}
      }
    },
    "human_ratifier": {"type": "string", "minLength": 1},
    "validator_ratifier": {"type": "string", "minLength": 1},
    "authority_basis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "phase"],
      "properties": {
        "mode": {"const": "phase-ratification"},
        "phase": {"const": "operational-maturity"}
      }
    },
    "max_review_rounds": {"type": "integer", "minimum": 1, "maximum": 8},
    "triggers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {"$ref": "#/$defs/trigger"}
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "backreference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "artifact_digest", "item_id", "intent_digest"],
      "properties": {
        "artifact_id": {"type": "string", "minLength": 1},
        "artifact_digest": {"$ref": "#/$defs/digest"},
        "item_id": {"type": "string", "minLength": 1},
        "intent_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "test_assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["test_id", "assertion_digest"],
      "properties": {
        "test_id": {"type": "string", "minLength": 1, "maxLength": 1024},
        "assertion_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "obligation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "obligation_id",
        "criterion",
        "verifier_id",
        "intent_backreferences",
        "required_evidence_ids",
        "test_assertions"
      ],
      "properties": {
        "obligation_id": {"$ref": "#/$defs/id"},
        "criterion": {"type": "string", "minLength": 1, "maxLength": 8192},
        "verifier_id": {
          "enum": [
            "validator-test-execution-v1",
            "validator-artifact-rehash-v1",
            "validator-exact-value-v1"
          ]
        },
        "intent_backreferences": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {"$ref": "#/$defs/backreference"}
        },
        "required_evidence_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/id"}
        },
        "test_assertions": {
          "type": "array",
          "maxItems": 256,
          "items": {"$ref": "#/$defs/test_assertion"}
        }
      }
    },
    "trigger": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trigger_id",
        "from_state",
        "to_state",
        "command_digest",
        "configuration_digest",
        "environment_digest",
        "obligations"
      ],
      "properties": {
        "trigger_id": {"$ref": "#/$defs/id"},
        "from_state": {"type": "string", "minLength": 1},
        "to_state": {"type": "string", "minLength": 1},
        "command_digest": {"$ref": "#/$defs/digest"},
        "configuration_digest": {"$ref": "#/$defs/digest"},
        "environment_digest": {"$ref": "#/$defs/digest"},
        "obligations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {"$ref": "#/$defs/obligation"}
        }
      }
    }
  }
}

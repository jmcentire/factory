{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "factory://schemas/target-resolution-request/1",
  "title": "Factory target-resolution request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "run_id",
    "repository_id",
    "generation",
    "target_manifest_digest",
    "target_manifest_source_digest",
    "normalized_url",
    "requested_ref",
    "subpath",
    "allowed_contact_operations",
    "lane_execution",
    "nonce",
    "created_at",
    "expires_at"
  ],
  "properties": {
    "schema_version": {"const": "factory-target-resolution-request/1"},
    "request_id": {"$ref": "#/$defs/id"},
    "run_id": {"$ref": "#/$defs/id"},
    "repository_id": {"type": "string", "minLength": 1},
    "generation": {"type": "integer", "minimum": 1},
    "target_manifest_digest": {"$ref": "#/$defs/digest"},
    "target_manifest_source_digest": {"$ref": "#/$defs/digest"},
    "normalized_url": {"type": "string", "minLength": 1},
    "requested_ref": {"type": "string", "minLength": 1, "maxLength": 1024},
    "subpath": {"type": "string", "maxLength": 4096},
    "allowed_contact_operations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["git-ls-remote", "git-fetch", "git-local-object-read"]
      }
    },
    "lane_execution": {"const": false},
    "nonce": {"type": "string", "minLength": 16, "maxLength": 256},
    "created_at": {"type": "integer", "minimum": 1},
    "expires_at": {"type": "integer", "minimum": 1}
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}

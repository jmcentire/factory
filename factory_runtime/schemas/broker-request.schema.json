{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "factory://schemas/broker-request/1",
  "title": "Factory typed broker operation request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "run_id",
    "generation",
    "role",
    "capability_digest",
    "operation_kind",
    "idempotency_key",
    "input",
    "input_digest",
    "created_at"
  ],
  "properties": {
    "schema_version": {"const": "factory-broker-request/1"},
    "request_id": {"$ref": "#/$defs/id"},
    "run_id": {"$ref": "#/$defs/id"},
    "generation": {"type": "integer", "minimum": 1},
    "role": {"enum": ["coder", "tester", "validator"]},
    "capability_digest": {"$ref": "#/$defs/digest"},
    "operation_kind": {"enum": ["read-artifact", "publish-artifact", "run-verifier"]},
    "idempotency_key": {"$ref": "#/$defs/id"},
    "input": {"type": "object"},
    "input_digest": {"$ref": "#/$defs/digest"},
    "created_at": {"type": "integer", "minimum": 1}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}

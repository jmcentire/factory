{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "factory://schemas/lane-completion-receipt/1",
  "title": "Factory portable lane completion receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "receipt_id", "run_id", "attempt_id", "role", "status", "contract_digest", "declared_artifacts"],
  "properties": {
    "schema_version": {"const": "factory-lane-completion-receipt/1"},
    "receipt_id": {"$ref": "#/$defs/id"},
    "run_id": {"$ref": "#/$defs/id"},
    "attempt_id": {"$ref": "#/$defs/id"},
    "role": {"enum": ["coder", "tester", "validator"]},
    "status": {"enum": ["complete", "blocked", "contaminated", "failed"]},
    "contract_digest": {"$ref": "#/$defs/digest"},
    "declared_artifacts": {
      "type": "array",
      "maxItems": 32,
      "items": {"$ref": "#/$defs/artifact"}
    },
    "summary": {"type": "string", "maxLength": 4096},
    "questions": {"type": "array", "maxItems": 32, "items": {"type": "string", "minLength": 1, "maxLength": 1024}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "path": {"type": "string", "minLength": 1, "maxLength": 4096},
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "digest"],
      "properties": {
        "kind": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
        "path": {"$ref": "#/$defs/path"},
        "digest": {"$ref": "#/$defs/digest"}
      }
    }
  }
}

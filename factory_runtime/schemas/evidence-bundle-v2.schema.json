{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "factory://schemas/evidence-bundle/2",
  "title": "Factory change evidence bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "target_digest",
    "source_digest",
    "candidate_digest",
    "acceptance_tests_digest",
    "generation_artifacts",
    "review_snapshots",
    "build_attempt",
    "ledger_head",
    "phase_artifacts",
    "trusted_artifact_digests",
    "claims",
    "checklist_results",
    "surface_evidence",
    "determinism_records",
    "lane",
    "independence",
    "monitors"
  ],
  "properties": {
    "schema_version": {
      "const": "factory-evidence-bundle/2"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "target_digest": {
      "$ref": "#/$defs/digest"
    },
    "source_digest": {
      "$ref": "#/$defs/digest"
    },
    "candidate_digest": {
      "$ref": "#/$defs/digest"
    },
    "acceptance_tests_digest": {
      "$ref": "#/$defs/digest"
    },
    "generation_artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target-manifest-source",
        "pattern-catalog",
        "pattern-catalog-source",
        "build-plan",
        "build-plan-source",
        "build-input",
        "generation-readiness"
      ],
      "properties": {
        "target-manifest-source": {
          "$ref": "#/$defs/digest"
        },
        "pattern-catalog": {
          "$ref": "#/$defs/digest"
        },
        "pattern-catalog-source": {
          "$ref": "#/$defs/digest"
        },
        "build-plan": {
          "$ref": "#/$defs/digest"
        },
        "build-plan-source": {
          "$ref": "#/$defs/digest"
        },
        "build-input": {
          "$ref": "#/$defs/digest"
        },
        "generation-readiness": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "review_snapshots": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "coder-output",
        "tester-output"
      ],
      "properties": {
        "coder-output": {
          "$ref": "#/$defs/digest"
        },
        "tester-output": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "build_attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "number",
        "limit"
      ],
      "properties": {
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "limit": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "ledger_head": {
      "$ref": "#/$defs/ledger_head"
    },
    "phase_artifacts": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "$ref": "factory://schemas/phase-artifact/1"
      }
    },
    "trusted_artifact_digests": {
      "type": "object",
      "minProperties": 3,
      "additionalProperties": {
        "$ref": "#/$defs/digest"
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim_id",
          "kind",
          "backreference"
        ],
        "properties": {
          "claim_id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "requirement",
              "constraint",
              "task",
              "test-assertion",
              "monitor"
            ]
          },
          "backreference": {
            "$ref": "#/$defs/backreference"
          }
        }
      }
    },
    "checklist_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/checklist_result"
      }
    },
    "surface_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/surface_evidence"
      }
    },
    "determinism_records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/determinism_record"
      }
    },
    "lane": {
      "enum": [
        "capability",
        "correction"
      ]
    },
    "independence": {
      "$ref": "#/$defs/independence"
    },
    "monitors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/monitor"
      }
    },
    "monitor_declared_unit_count": {
      "type": "integer",
      "minimum": 0
    },
    "correction": {
      "$ref": "#/$defs/correction"
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "body",
        "claimed_digest"
      ],
      "properties": {
        "body": {
          "type": "object"
        },
        "claimed_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "checklist_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "passed",
        "detail",
        "recorded_at",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "passed": {
          "type": "boolean"
        },
        "detail": {
          "type": "string"
        },
        "recorded_at": {
          "type": "integer",
          "minimum": 1
        },
        "evidence": {
          "$ref": "#/$defs/integrity"
        }
      }
    },
    "surface_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface_id",
        "criticality",
        "oracle_adequate",
        "required_evidence_ids",
        "evidence_digests"
      ],
      "properties": {
        "surface_id": {
          "type": "string",
          "minLength": 1
        },
        "criticality": {
          "enum": [
            "critical",
            "standard",
            "cosmetic"
          ]
        },
        "oracle_adequate": {
          "type": "boolean"
        },
        "required_evidence_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidence_digests": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/digest"
          }
        }
      }
    },
    "determinism_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface_id",
        "criticality",
        "deterministic",
        "flake_count",
        "automatic_retry_count"
      ],
      "properties": {
        "surface_id": {
          "type": "string",
          "minLength": 1
        },
        "criticality": {
          "enum": [
            "critical",
            "standard",
            "cosmetic"
          ]
        },
        "deterministic": {
          "type": "boolean"
        },
        "flake_count": {
          "type": "integer",
          "minimum": 0
        },
        "automatic_retry_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "backreference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "artifact_digest",
        "item_id",
        "intent_digest"
      ],
      "properties": {
        "artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "artifact_digest": {
          "$ref": "#/$defs/digest"
        },
        "item_id": {
          "type": "string",
          "minLength": 1
        },
        "intent_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "independence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agents",
        "shared_context",
        "channel_open",
        "mechanism_ids",
        "claimed_tier",
        "structural_mode",
        "derived_tier"
      ],
      "properties": {
        "agents": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "role",
              "model_family",
              "model_version",
              "directive_version"
            ],
            "properties": {
              "role": {
                "enum": [
                  "coder",
                  "tester",
                  "validator"
                ]
              },
              "model_family": {
                "type": "string",
                "minLength": 1
              },
              "model_version": {
                "type": "string",
                "minLength": 1
              },
              "directive_version": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "shared_context": {
          "type": "boolean"
        },
        "channel_open": {
          "type": "boolean"
        },
        "mechanism_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "claimed_tier": {
          "enum": [
            "weakest",
            "weak",
            "moderate",
            "stronger",
            "strongest"
          ]
        },
        "derived_tier": {
          "enum": [
            "weakest",
            "weak",
            "moderate",
            "stronger",
            "strongest"
          ]
        },
        "structural_mode": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "contract_backreference",
            "mutation_evidence",
            "decision_package_note"
          ],
          "properties": {
            "mode": {
              "enum": [
                "isolated",
                "implementation-informed"
              ]
            },
            "contract_backreference": {
              "oneOf": [
                {
                  "$ref": "#/$defs/backreference"
                },
                {
                  "type": "null"
                }
              ]
            },
            "mutation_evidence": {
              "oneOf": [
                {
                  "$ref": "#/$defs/integrity"
                },
                {
                  "type": "null"
                }
              ]
            },
            "decision_package_note": {
              "type": "string"
            }
          }
        }
      }
    },
    "monitor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "monitor_id",
        "surface_id",
        "derivation",
        "authorship",
        "author_identity",
        "backreference",
        "actionable_conclusion",
        "notifies_human",
        "fix_references"
      ],
      "properties": {
        "monitor_id": {
          "type": "string",
          "minLength": 1
        },
        "surface_id": {
          "type": "string",
          "minLength": 1
        },
        "derivation": {
          "const": "specification"
        },
        "authorship": {
          "enum": [
            "human",
            "generated"
          ]
        },
        "author_identity": {
          "type": "string"
        },
        "backreference": {
          "$ref": "#/$defs/backreference"
        },
        "actionable_conclusion": {
          "type": "string"
        },
        "notifies_human": {
          "type": "boolean"
        },
        "fix_references": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "correction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "defect_id",
        "baseline_available",
        "controls",
        "reproduction"
      ],
      "properties": {
        "defect_id": {
          "type": "string",
          "minLength": 1
        },
        "baseline_available": {
          "type": "boolean"
        },
        "controls": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "test_id",
              "declared_role",
              "baseline_result",
              "failure_relation"
            ],
            "properties": {
              "test_id": {
                "type": "string",
                "minLength": 1
              },
              "declared_role": {
                "enum": [
                  "red-now",
                  "green-now"
                ]
              },
              "baseline_result": {
                "enum": [
                  "failed",
                  "passed"
                ]
              },
              "failure_relation": {
                "enum": [
                  "",
                  "defect",
                  "unrelated"
                ]
              }
            }
          }
        },
        "reproduction": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "defect_id",
                "result",
                "environment_id",
                "disposable_environment",
                "recorded_before_repair",
                "impossibility_condition",
                "evidence"
              ],
              "properties": {
                "defect_id": {
                  "type": "string",
                  "minLength": 1
                },
                "result": {
                  "enum": [
                    "reproduced",
                    "not-reproduced",
                    "impossible"
                  ]
                },
                "environment_id": {
                  "type": "string"
                },
                "disposable_environment": {
                  "type": "boolean"
                },
                "recorded_before_repair": {
                  "type": "boolean"
                },
                "impossibility_condition": {
                  "type": "string"
                },
                "evidence": {
                  "oneOf": [
                    {
                      "$ref": "#/$defs/integrity"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "ledger_head": {
      "type": "string",
      "pattern": "^(sha256|hmac-sha256):[0-9a-f]{64}$",
      "description": "A ledger-head address: sha256 (unkeyed, migration-only) or hmac-sha256 (keyed, plan 2.2)."
    }
  }
}

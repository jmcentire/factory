{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "factory://schemas/phase-artifact/1",
  "title": "Factory phase artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_id",
    "phase",
    "version",
    "source_digest",
    "human_ratifier",
    "validator_ratifier",
    "items"
  ],
  "properties": {
    "artifact_id": {
      "type": "string",
      "minLength": 1
    },
    "phase": {
      "enum": [
        "product-specification",
        "architecture",
        "operational-maturity"
      ]
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "source_digest": {
      "$ref": "#/$defs/digest"
    },
    "human_ratifier": {
      "type": "string",
      "minLength": 1
    },
    "validator_ratifier": {
      "type": "string",
      "minLength": 1
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/item"
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "backreference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "artifact_digest",
        "item_id",
        "intent_digest"
      ],
      "properties": {
        "artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "artifact_digest": {
          "$ref": "#/$defs/digest"
        },
        "item_id": {
          "type": "string",
          "minLength": 1
        },
        "intent_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item_id",
        "canonical_statement",
        "supersedes"
      ],
      "properties": {
        "item_id": {
          "type": "string",
          "minLength": 1
        },
        "canonical_statement": {
          "type": "string",
          "minLength": 1
        },
        "supersedes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/backreference"
          }
        }
      }
    }
  }
}

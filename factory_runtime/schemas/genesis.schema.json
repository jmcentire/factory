{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "factory://schemas/genesis/1",
  "title": "Factory authority genesis",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "repository_id",
    "policy_id",
    "root_public_key",
    "principals",
    "bootstrap",
    "issued_at"
  ],
  "properties": {
    "schema_version": {
      "const": "factory-genesis/1"
    },
    "repository_id": {
      "type": "string",
      "minLength": 1
    },
    "policy_id": {
      "type": "string",
      "minLength": 1
    },
    "root_public_key": {
      "$ref": "#/$defs/public_key"
    },
    "principals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "identity",
          "kind",
          "public_key",
          "capabilities"
        ],
        "properties": {
          "identity": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "human",
              "agent",
              "service"
            ]
          },
          "public_key": {
            "$ref": "#/$defs/public_key"
          },
          "capabilities": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "bootstrap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "scope",
        "deactivates_when"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "scope": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "deactivates_when": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "issued_at": {
      "type": "integer",
      "minimum": 1
    }
  },
  "$defs": {
    "public_key": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}

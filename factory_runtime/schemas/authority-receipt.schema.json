{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "factory://schemas/authority-receipt/1",
  "title": "Factory authority receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_id",
    "run_id",
    "repository_id",
    "action",
    "subject_digest",
    "signer_identity",
    "capabilities",
    "issued_at",
    "expires_at",
    "nonce"
  ],
  "properties": {
    "schema_version": {
      "const": "factory-authority-receipt/1"
    },
    "receipt_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "repository_id": {
      "type": "string",
      "minLength": 1
    },
    "action": {
      "enum": [
        "authorize-target-resolution",
        "authorize-change",
        "ratify-product-specification",
        "ratify-architecture",
        "ratify-operational-maturity",
        "approve-promotion",
        "activate-policy"
      ]
    },
    "subject_digest": {
      "$ref": "#/$defs/digest"
    },
    "signer_identity": {
      "type": "string",
      "minLength": 1
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "issued_at": {
      "type": "integer",
      "minimum": 1
    },
    "expires_at": {
      "type": "integer",
      "minimum": 1
    },
    "nonce": {
      "type": "string",
      "minLength": 16
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}

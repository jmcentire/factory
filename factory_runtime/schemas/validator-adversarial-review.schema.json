{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "factory://schemas/validator-adversarial-review/1",
  "title": "Factory Validator adversarial code-review report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "authority",
    "subject_digest",
    "reviewer_identity",
    "acceptance_observations_digest",
    "dimensions",
    "requirement_dispositions",
    "architecture_dispositions",
    "operational_maturity_dispositions",
    "failure_mode_probes",
    "clean_claim_challenges",
    "findings",
    "completeness",
    "verdict"
  ],
  "properties": {
    "schema_version": {"const": "factory-validator-adversarial-review/1"},
    "authority": {"const": "review-evidence-only"},
    "subject_digest": {"$ref": "#/$defs/digest"},
    "reviewer_identity": {"type": "string", "minLength": 1},
    "acceptance_observations_digest": {"$ref": "#/$defs/digest"},
    "dimensions": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["dimension_id", "state", "summary", "evidence"],
        "properties": {
          "dimension_id": {"$ref": "#/$defs/dimension"},
          "state": {"$ref": "#/$defs/state"},
          "summary": {"$ref": "#/$defs/review_narrative_short"},
          "evidence": {
            "type": "array",
            "maxItems": 32,
            "items": {"$ref": "#/$defs/evidence"}
          }
        }
      }
    },
    "requirement_dispositions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {"$ref": "#/$defs/item_disposition"}
    },
    "architecture_dispositions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {"$ref": "#/$defs/item_disposition"}
    },
    "operational_maturity_dispositions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {"$ref": "#/$defs/item_disposition"}
    },
    "failure_mode_probes": {
      "type": "array",
      "maxItems": 1024,
      "items": {"$ref": "#/$defs/failure_mode_probe"}
    },
    "clean_claim_challenges": {
      "type": "array",
      "maxItems": 1024,
      "items": {"$ref": "#/$defs/clean_claim_challenge"}
    },
    "findings": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "finding_id",
          "dimension_id",
          "severity",
          "statement",
          "consequence",
          "evidence"
        ],
        "properties": {
          "finding_id": {"$ref": "#/$defs/digest"},
          "dimension_id": {"$ref": "#/$defs/dimension"},
          "severity": {"enum": ["blocking", "should-fix", "minor"]},
          "statement": {"$ref": "#/$defs/review_narrative"},
          "consequence": {"$ref": "#/$defs/review_narrative"},
          "evidence": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {"$ref": "#/$defs/evidence"}
          }
        }
      }
    },
    "completeness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "summary", "checks", "evidence"],
      "properties": {
        "state": {"$ref": "#/$defs/state"},
        "summary": {"$ref": "#/$defs/review_narrative"},
        "checks": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["check_id", "state", "summary", "evidence"],
            "properties": {
              "check_id": {"$ref": "#/$defs/completeness_check"},
              "state": {"$ref": "#/$defs/state"},
              "summary": {"$ref": "#/$defs/review_narrative_short"},
              "evidence": {
                "type": "array",
                "maxItems": 32,
                "items": {"$ref": "#/$defs/evidence"}
              }
            }
          }
        },
        "evidence": {
          "type": "array",
          "maxItems": 32,
          "items": {"$ref": "#/$defs/evidence"}
        }
      }
    },
    "verdict": {
      "enum": [
        "CLEAN_QUALIFIED",
        "BLOCK",
        "CHANGES_REQUESTED",
        "INCOMPLETE",
        "STALE",
        "DISPUTED"
      ]
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "review_narrative": {"type": "string", "minLength": 24, "maxLength": 4000},
    "review_narrative_short": {"type": "string", "minLength": 24, "maxLength": 2000},
    "dimension": {
      "enum": [
        "intent-conformance",
        "architecture",
        "redundancy",
        "clarity",
        "separation-of-concerns",
        "test-adequacy",
        "correctness-and-failure",
        "scope-control"
      ]
    },
    "state": {
      "enum": ["COMPLETED", "CAPABILITY_FAILED", "TIMEOUT", "PARSE_FAILED", "SKIPPED", "STALE"]
    },
    "completeness_check": {
      "enum": [
        "dimension-coverage",
        "subject-binding",
        "test-evidence",
        "failure-mode-coverage",
        "change-reach",
        "authority-context",
        "clean-claim-challenge"
      ]
    },
    "intent_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "artifact_digest", "item_id", "intent_digest"],
      "properties": {
        "artifact_id": {"type": "string", "minLength": 1, "maxLength": 1024},
        "artifact_digest": {"$ref": "#/$defs/digest"},
        "item_id": {"type": "string", "minLength": 1, "maxLength": 1024},
        "intent_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "item_disposition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "artifact_digest",
        "item_id",
        "intent_digest",
        "disposition",
        "summary",
        "evidence",
        "finding_ids"
      ],
      "properties": {
        "artifact_id": {"type": "string", "minLength": 1, "maxLength": 1024},
        "artifact_digest": {"$ref": "#/$defs/digest"},
        "item_id": {"type": "string", "minLength": 1, "maxLength": 1024},
        "intent_digest": {"$ref": "#/$defs/digest"},
        "disposition": {"enum": ["CONFORMS", "VIOLATES", "UNRESOLVED"]},
        "summary": {"$ref": "#/$defs/review_narrative"},
        "evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {"$ref": "#/$defs/evidence"}
        },
        "finding_ids": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/digest"}
        }
      }
    },
    "failure_mode_probe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "probe_id",
        "obligation_id",
        "verifier_id",
        "effect_digest",
        "test_result",
        "probe_method",
        "failure_mode",
        "attempt",
        "expected_result",
        "observed_result",
        "outcome",
        "evidence",
        "finding_ids"
      ],
      "properties": {
        "probe_id": {"$ref": "#/$defs/digest"},
        "obligation_id": {"$ref": "#/$defs/id"},
        "verifier_id": {
          "enum": [
            "validator-test-execution-v1",
            "validator-artifact-rehash-v1",
            "validator-exact-value-v1"
          ]
        },
        "effect_digest": {"$ref": "#/$defs/digest"},
        "test_result": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["test_id", "assertion_digest", "output_digest"],
              "properties": {
                "test_id": {"type": "string", "minLength": 1, "maxLength": 1024},
                "assertion_digest": {"$ref": "#/$defs/digest"},
                "output_digest": {"$ref": "#/$defs/digest"}
              }
            }
          ]
        },
        "probe_method": {
          "enum": ["inspect-observed-test-result/1", "recheck-observed-effect/1"]
        },
        "failure_mode": {"$ref": "#/$defs/review_narrative"},
        "attempt": {"$ref": "#/$defs/review_narrative"},
        "expected_result": {"$ref": "#/$defs/review_narrative"},
        "observed_result": {"$ref": "#/$defs/review_narrative"},
        "outcome": {"enum": ["PASSED", "FAILED", "INCONCLUSIVE"]},
        "evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {"$ref": "#/$defs/evidence"}
        },
        "finding_ids": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/digest"}
        }
      }
    },
    "clean_claim_challenge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "challenge_id",
        "challenge_method",
        "authority_evidence_index",
        "produced_evidence_index",
        "hypothesis",
        "attempt",
        "observed_result",
        "outcome",
        "evidence",
        "finding_ids"
      ],
      "properties": {
        "challenge_id": {"$ref": "#/$defs/digest"},
        "challenge_method": {"const": "compare-exact-evidence/1"},
        "authority_evidence_index": {"type": "integer", "minimum": 0, "maximum": 31},
        "produced_evidence_index": {"type": "integer", "minimum": 0, "maximum": 31},
        "hypothesis": {"$ref": "#/$defs/review_narrative"},
        "attempt": {"$ref": "#/$defs/review_narrative"},
        "observed_result": {"$ref": "#/$defs/review_narrative"},
        "outcome": {"enum": ["REFUTED", "CONFIRMED", "INCONCLUSIVE"]},
        "evidence": {
          "type": "array",
          "minItems": 2,
          "maxItems": 32,
          "items": {"$ref": "#/$defs/evidence"}
        },
        "finding_ids": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/digest"}
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "path", "start_line", "end_line", "excerpt_digest"],
      "properties": {
        "source": {
          "enum": [
            "implementation",
            "acceptance-tests",
            "build-input",
            "pattern-catalog",
            "build-plan",
            "acceptance-obligation-catalog",
            "acceptance-observations",
            "baseline-source",
            "candidate-change-set",
            "review-authority-context",
            "operator-intent"
          ]
        },
        "path": {"type": "string", "minLength": 1, "maxLength": 1024},
        "start_line": {"type": "integer", "minimum": 1},
        "end_line": {"type": "integer", "minimum": 1},
        "excerpt_digest": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
